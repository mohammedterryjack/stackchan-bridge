{
  "allow": [
    "search_papers",
    "get_abstract",
    "download_paper"
  ],
  "rename": {
    "search_papers": "arxiv_search",
    "get_abstract": "arxiv_abstract",
    "download_paper": "arxiv_read"
  },
  "descriptions": {
    "search_papers": "Research papers on arXiv about a topic.",
    "get_abstract": "A short summary of one arXiv paper by id.",
    "download_paper": "Read an arXiv paper aloud in parts by id."
  },
  "add_params": {
    "download_paper": {
      "part": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "description": "Part number, 1 = start."
      }
    }
  },
  "hide_params": {
    "download_paper": [
      "return_full_text",
      "force",
      "start",
      "max_chars"
    ]
  },
  "arxiv_part_tools": [
    "download_paper"
  ],
  "call_defaults": {
    "search_papers": {
      "max_results": 5
    }
  },
  "schema_defaults": {
    "search_papers": {
      "max_results": 5
    }
  },
  "maxima": {
    "search_papers": {
      "max_results": 10
    }
  },
  "drop_params": {
    "search_papers": [
      "start",
      "abstract_mode",
      "date_from",
      "date_to",
      "categories"
    ]
  },
  "reply_format": {
    "search_papers": "arxiv_search",
    "get_abstract": "arxiv_abstract_short",
    "download_paper": "arxiv_read"
  },
  "strip_prefixes": {
    "get_abstract": {
      "paper_id": [
        "arxiv:",
        "arxiv"
      ]
    },
    "download_paper": {
      "paper_id": [
        "arxiv:",
        "arxiv"
      ]
    }
  }
}
